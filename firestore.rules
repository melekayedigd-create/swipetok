rules_version = '2';
// SwipePlay — paste this in Firebase console ▸ Firestore Database ▸ Rules ▸ Publish
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{gameId} {
      allow read: if true;
      // anyone signed in (anonymous is fine) can publish a game in their own name
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() <= 60
        && request.resource.data.project is string && request.resource.data.project.size() < 300000
        && request.resource.data.likes == 0 && request.resource.data.comments == 0;
      // others may only change the like / comment counters, by at most 1
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'comments'])
        && request.resource.data.likes - resource.data.likes <= 1
        && resource.data.likes - request.resource.data.likes <= 1
        && request.resource.data.comments - resource.data.comments <= 1
        && request.resource.data.comments >= resource.data.comments;
      // only the author can delete (unpublish)
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 300;
      }
      match /likes/{uid} {
        allow read: if true;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
